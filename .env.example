# Copy to .env for local Docker runs only — never commit .env
SPRING_PROFILES_ACTIVE=prod
PORT=8080
BOOKING_DB_PATH=./booking.db
BOOKING_BASE_URL=https://your-app.onrender.com
BOOKING_ADMIN_PIN=use-a-long-random-pin
BOOKING_EMAIL_ENABLED=false
BOOKING_REMINDERS_ENABLED=false
BOOKING_SMS_ENABLED=false

# If BOOKING_EMAIL_ENABLED=true:
# BOOKING_REMINDERS_FROM=no-reply@yourdomain.com
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# If BOOKING_SMS_ENABLED=true:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
